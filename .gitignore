# Окружение и модели
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Модели и данные (качаются автоматически, весят сотни МБ)
models/
data/
!data/.gitkeep

# Логи
*.log

# Записи микрофона
*.wav
!tests/fixtures/*.wav

# Личные рабочие документы
# Это не проект: заметки и техзадания автора. В репозитории им не
# место — они нужны только тебе и меняются по ходу мыслей.
# Техзадание по плагинам при этом важно: прежде чем им следовать,
# спроси, где оно лежит.
ТЗ по Sinaps.md
Памятка для себя.md
*.ТЗ.md
Памятка*.md

# Локальные плагины пользователя (папка есть в репозитории, содержимое — нет)
plugins/*
!plugins/.gitkeep

# Исключение: погода — часть проекта, а не личный плагин.
# Порядок строк важен: сначала исключается содержимое plugins/, потом
# возвращается сама папка weather. Без второго правила git не заходит
# внутрь исключённого каталога и не увидит файлы даже с явным плюсом.
!plugins/weather/

# OS
.DS_Store
Thumbs.db
